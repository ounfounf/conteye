{
  "imports": {
    "@std/fs": "jsr:@std/fs@0.203.0",
    "@std/cli": "jsr:@std/cli@^1.0.0",
    "@std/path": "jsr:@std/path",
    "@logtape/logtape": "jsr:@logtape/logtape",
    "@duckdb/node-api": "npm:@duckdb/node-api",
    "hash-wasm": "npm:hash-wasm@4.11.0",
    "~/": "./src/",
    "~test/": "./test/"
  },
  "tasks": {
    "main": "deno run --allow-read --allow-write --allow-ffi src/mod.ts",
    "server": "deno run --allow-net --allow-read --allow-write --allow-ffi src/server.ts",
    "test": "deno test --allow-write --allow-read --allow-net --allow-ffi",
    "check": "deno check src/ test/"
  }
}
