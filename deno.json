{
  "imports": {
    "@std/fs": "jsr:@std/fs@0.203.0",
    "@std/cli": "jsr:@std/cli@^1.0.0",
    "@std/path": "jsr:@std/path",
    "@logtape/logtape": "jsr:@logtape/logtape",
    "@duckdb/node-api": "npm:@duckdb/node-api",
    "hash-wasm": "npm:hash-wasm@4.11.0",
    "graphql": "npm:graphql@16.9.0",
    "~/": "./src/",
    "~test/": "./test/"
  },
  "tasks": {
    "server": "deno run --allow-net --allow-read --allow-write --allow-ffi --allow-env src/server.ts --db tmp.db",
    "server:worker": "deno run --allow-net --allow-read --allow-write --allow-env src/server.ts --no-db",
    "test": "deno test src/ test/ --allow-write --allow-read --allow-net --allow-ffi --allow-env",
    "check": "deno check src/ test/"
  }
}
